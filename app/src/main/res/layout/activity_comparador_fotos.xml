<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#8B4789"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Compare Progress"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Compare two progress photos side by side"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Instructions -->
        <TextView
            android:id="@+id/tvInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select two photos from your progress gallery to compare"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:padding="16dp"/>

        <!-- Select Photos Button -->
        <Button
            android:id="@+id/btnSelectPhotos"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_margin="16dp"
            android:text="📷 SELECT PHOTOS"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8B4789"/>

        <!-- Comparison Container -->
        <LinearLayout
            android:id="@+id/comparisonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="16dp">

            <!-- Before and After Photos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Photo 1 (Before) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BEFORE"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#8B4789"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"/>

                    <ImageView
                        android:id="@+id/ivPhoto1"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:scaleType="centerCrop"
                        android:background="#EEEEEE"
                        android:contentDescription="Before photo"/>

                    <TextView
                        android:id="@+id/tvPhoto1Info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Month - Weight"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- Photo 2 (After) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AFTER"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#E91E63"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"/>

                    <ImageView
                        android:id="@+id/ivPhoto2"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:scaleType="centerCrop"
                        android:background="#EEEEEE"
                        android:contentDescription="After photo"/>

                    <TextView
                        android:id="@+id/tvPhoto2Info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Month - Weight"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Comparison Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈 Progress Summary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvWeightDifference"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weight Change: N/A"
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvTimeDifference"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time Period: N/A"
                    android:textSize="16sp"
                    android:textColor="#666666"/>
            </LinearLayout>

            <!-- Change Photos Button -->
            <Button
                android:id="@+id/btnChangePhotos"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="🔄 CHANGE PHOTOS"
                android:textColor="#666666"
                android:backgroundTint="#EEEEEE"
                android:layout_marginTop="16dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>